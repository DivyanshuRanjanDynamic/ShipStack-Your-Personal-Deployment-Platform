# ShipStack frontend configuration. Copy to .env for local development.

# Base URL of the ShipStack api-server. Defaults to http://localhost:9000 in development.
# (VITE_API_BASE_URL is still read as a fallback.)
VITE_API_URL=http://localhost:9000

# Demo mode serves built-in sample data instead of calling the API. It turns on by itself in a
# production build with no reachable API (no VITE_API_URL, or a localhost URL on a public site).
# Set to "true" to force it on, or "false" to turn it off entirely.
# VITE_DEMO_MODE=

# Optional link to a demo video, shown in the demo-mode banner.
# VITE_DEMO_VIDEO_URL=
